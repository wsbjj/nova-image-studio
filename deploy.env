# Server
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Persistent data inside the Docker volume mount.
NOVA_TASK_DB=/app/backend/data/nova-tasks.sqlite
NOVA_IMAGE_DIR=/app/backend/data/nova-images

# Queue and rate limits
NOVA_TASK_CONCURRENCY=50
NOVA_MAX_QUEUE_SIZE=200
NOVA_RATE_LIMIT_WINDOW_MS=60000
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=20
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=20
NOVA_MAX_PENDING_TASKS_PER_IP=20
NOVA_MAX_PENDING_TASKS_PER_API_KEY=10
NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=30

# Prompt gallery: 1=always visible, 2=password mode, 3=disabled.
PROMPT_GALLERY_MODE=1
PROMPT_GALLERY_PASSWORD=
