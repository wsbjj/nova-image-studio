ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE}

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# better-sqlite3 is a native dependency and may need a compiler toolchain
# when no prebuilt binary matches the container runtime.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

EXPOSE 3000

CMD ["node", "backend/server.js"]
